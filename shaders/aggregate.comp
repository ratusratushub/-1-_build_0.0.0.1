#version 430 core
// Histogram -> exclusive prefix -> scatter, no floating-point atomic sums.
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer Positions { vec4 positions[]; };
layout(std430,binding=4) buffer Membership { uint membership[]; };
layout(std430,binding=5) buffer Counts { uint counts[]; }; // histogram, then scatter cursors
layout(std430,binding=6) buffer Offsets { uint offsets[]; };
layout(std430,binding=7) writeonly buffer SortedSlots { uint slots[]; };
uniform uint particleCount,baseParticle,gridSide,mode;
uniform float halfExtent;
#include "grid.glsl"
uint locate(vec3 p) {
    uint exterior=gridSide*gridSide*gridSide;
    if(any(isnan(p))||any(isinf(p))||any(lessThan(p,vec3(-halfExtent)))||any(greaterThan(p,vec3(halfExtent)))) return exterior;
    // Same policy as World::locate, including positive outer boundary.
    uvec3 c=uvec3(chunkCoordinates(p));
    return (c.z*gridSide+c.y)*gridSide+c.x;
}
void main() {
    uint id=baseParticle+gl_GlobalInvocationID.x;
    uint buckets=gridSide*gridSide*gridSide+1u;
    if(mode==1u) {
        if(gl_GlobalInvocationID.x!=0u) return;
        uint total=0u;
        for(uint c=0u;c<buckets;++c) {offsets[c]=total;counts[buckets+c]=total;total+=counts[c];}
        offsets[buckets]=total;
        return;
    }
    if(id>=particleCount) return;
    if(mode==0u) {uint c=locate(positions[id].xyz);membership[id]=c;atomicAdd(counts[c],1u);}
    else {uint c=membership[id];uint slot=atomicAdd(counts[buckets+c],1u);if(slot<particleCount) slots[slot]=id;}
}
