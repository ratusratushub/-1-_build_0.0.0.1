#version 430 core
// Explicit maintenance operation, separate from the per-frame simulation.
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer Positions {vec4 positions[];};
layout(std430,binding=1) readonly buffer Velocities {vec4 velocities[];};
layout(std430,binding=2) readonly buffer Identities {uint identities[];};
layout(std430,binding=3) buffer Counter {uint survivors;};
layout(std430,binding=4) readonly buffer Membership {uint membership[];};
layout(std430,binding=5) writeonly buffer NewPositions {vec4 newPositions[];};
layout(std430,binding=6) writeonly buffer NewVelocities {vec4 newVelocities[];};
layout(std430,binding=7) writeonly buffer NewIdentities {uint newIdentities[];};
uniform uint particleCount,baseParticle,targetChunk;
void main(){
    uint id=baseParticle+gl_GlobalInvocationID.x;if(id>=particleCount) return;
    if(membership[id]==targetChunk) return;
    uint outputSlot=atomicAdd(survivors,1u);
    if(outputSlot<particleCount){newPositions[outputSlot]=positions[id];newVelocities[outputSlot]=velocities[id];newIdentities[outputSlot]=identities[id];}
}
