#version 430 core
layout(local_size_x=256) in;
layout(std430,binding=0) buffer Positions { vec4 positions[]; };
layout(std430,binding=1) buffer Velocities { vec4 velocities[]; };
layout(std430,binding=2) readonly buffer Accelerations { vec4 accelerations[]; };
uniform uint particleCount,baseParticle,phase;
uniform float dt;
void main() {
    uint id=baseParticle+gl_GlobalInvocationID.x;
    if(id>=particleCount) return;
    vec3 v=velocities[id].xyz+0.5*dt*accelerations[id].xyz;
    velocities[id]=vec4(v,0);
    if(phase==0u) positions[id].xyz+=dt*v;
}
