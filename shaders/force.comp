#version 430 core
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer Positions { vec4 positions[]; };
layout(std430,binding=2) writeonly buffer Accelerations { vec4 accelerations[]; };
layout(std430,binding=3) readonly buffer Bodies { vec4 bodies[]; };
uniform uint particleCount,baseParticle,bodyCount,particleGravity;
uniform float gravityConstant,softening;
vec3 force(vec3 p,vec4 b) {
    vec3 d=b.xyz-p;
    float r2=dot(d,d)+softening*softening;
    float inv=inversesqrt(r2);
    return gravityConstant*b.w*d*inv*inv*inv;
}
void main() {
    uint id=baseParticle+gl_GlobalInvocationID.x;
    if(id>=particleCount) return;
    vec3 p=positions[id].xyz,a=vec3(0);
    for(uint i=0u;i<bodyCount;++i) a+=force(p,bodies[i]);
    // Explicit exact mode for small-N validation; never enabled silently at scale.
    if(particleGravity!=0u) for(uint i=0u;i<particleCount;++i) if(i!=id) a+=force(p,positions[i]);
    accelerations[id]=vec4(a,0);
}
