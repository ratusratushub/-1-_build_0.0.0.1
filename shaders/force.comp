#version 430 core
layout(local_size_x=256) in;

// Буферы частиц
layout(std430, binding=0) readonly buffer Positions { vec4 positions[]; };
layout(std430, binding=1) readonly buffer Velocities { vec4 velocities[]; };
layout(std430, binding=2) writeonly buffer Accelerations { vec4 accelerations[]; };
layout(std430, binding=3) readonly buffer Bodies { vec4 bodies[]; };

// Буферы индексации чанков
layout(std430, binding=4) readonly buffer Membership { uint membership[]; };
layout(std430, binding=5) readonly buffer Offsets { uint offsets[]; };
layout(std430, binding=6) readonly buffer Index { uint index[]; };

uniform uint particleCount, baseParticle, bodyCount;
uniform float gravityConstant, softening;

vec3 force(vec3 p, vec4 source) {
    vec3 d = source.xyz - p;
    float r2 = dot(d, d) + softening * softening;
    float inv = inversesqrt(r2);
    return gravityConstant * source.w * d * inv * inv * inv;
}

void main() {
    uint id = baseParticle + gl_GlobalInvocationID.x;
    if (id >= particleCount) return;
    
    vec3 p = positions[id].xyz;
    vec3 a = vec3(0);
    
    // Шаг 1: Сила от массивных тел (чёрная дыра и т.д.)
    for (uint i = 0u; i < bodyCount; ++i) {
        a += force(p, bodies[i]);
    }
    
    // Шаг 3: Точный расчёт внутри своего чанка
    uint chunk = membership[id];
    uint start = offsets[chunk];
    uint end = offsets[chunk + 1];
    
    for (uint i = start; i < end; ++i) {
        uint otherId = index[i];
        if (otherId != id) {
            a += force(p, positions[otherId]);
        }
    }
    
    accelerations[id] = vec4(a, 0);
}
